# Generate with openssl rand -hex 24
BRIDGE_TOKEN=
# VNC accepts eight ASCII alphanumeric characters. Use openssl rand -hex 4.
VNC_PASSWORD=
# Optional. With mcp_enabled: true, this distinct token exposes the shared tool catalog on /mcp.
MCP_TOKEN=
# Optional private config path
# BRIDGE_CONFIG_FILE=./config.local.yaml
# Optional loopback host ports. If BRIDGE_PORT changes, set AGENT_BRIDGE_URL for Agent commands.
# BRIDGE_PORT=8765
# NOVNC_PORT=6080
# Optional checksum of the corresponding official WeChat .deb download
# WECHAT_ARM64_SHA256=
# WECHAT_AMD64_SHA256=

# Desktop tools are enabled by default and provide session discovery and saved-session restore.
# Set false only when troubleshooting without the desktop driver.
# WECHAT_TOOLS_ENABLED=false
# WECHAT_TOOLS_AUTO_LOGIN=false
