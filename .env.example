# Generate with openssl rand -hex 24
BRIDGE_TOKEN=
# VNC accepts eight ASCII alphanumeric characters. Use openssl rand -hex 4.
VNC_PASSWORD=
# Optional. Supply a different token and enable MCP in config.yaml.
MCP_TOKEN=
# Optional private config path
# BRIDGE_CONFIG_FILE=./config.local.yaml
# Optional checksum of the corresponding official WeChat .deb download
# WECHAT_ARM64_SHA256=
# WECHAT_AMD64_SHA256=
