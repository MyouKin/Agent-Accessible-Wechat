# Copy this to .env.agent, keep it private, and edit the model settings.
# These defaults expect a local OpenAI-compatible llama.cpp server.
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=companion
LLM_API_KEY=local

AGENT_BRIDGE_URL=http://127.0.0.1:8765
AGENT_STATE_PATH=./data/agent.db
AGENT_MENTIONS=阿桥
AGENT_AUTO_SEND=false
AGENT_DATA_CONSENT=false

# Optional. Set these when the provider supports the corresponding capability.
# AGENT_PERSONA_PATH=./data/persona.md
# AGENT_MULTIMODAL=true
# LLM_QUOTE_TOOL=true
# LLM_MAX_TOKENS=280
# LLM_REASONING_EFFORT=none
