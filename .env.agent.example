# Copy this to .env.agent, keep it private, and edit the model settings.
# These defaults expect a local OpenAI-compatible llama.cpp server.
# Agent follows the active Bridge session. Use --list-sessions / --set-session KEY once to select it.
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=companion
LLM_API_KEY=local

# To use an ordered list instead, uncomment and configure each named provider.
# LLM_PROVIDER_ORDER=gemma,deepseek
# LLM_GEMMA_PROTOCOL=ollama
# LLM_GEMMA_BASE_URL=http://inference.lan:11434
# LLM_GEMMA_MODEL=gemma4
# LLM_GEMMA_TIMEOUT_SECONDS=30
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DEEPSEEK_MODEL=deepseek-flash
# LLM_DEEPSEEK_API_KEY=
# LLM_DEEPSEEK_REASONING_EFFORT=none

# Set this to the Bridge address accessible from the Agent host, including any SSH local forward.
# Set the matching BRIDGE_TOKEN in the Agent host's private .env.
AGENT_BRIDGE_URL=http://127.0.0.1:8765
AGENT_STATE_PATH=./data/agent.db
# Enter the nickname WeChat displays in @ mentions for the selected group, without the @.
# Multiple nicknames can be comma-separated. Leave empty to disable text mention triggers.
# AGENT_MENTIONS=
AGENT_AUTO_SEND=false
# Set true for non-loopback providers only after consent for the selected conversation.
AGENT_DATA_CONSENT=false

# Optional. Set these when the provider supports the corresponding capability.
# AGENT_PERSONA_PATH=./data/persona.md
# AGENT_MULTIMODAL=true
# Set false to disable the model's active-session read tools.
# AGENT_WECHAT_TOOLS=false
# LLM_QUOTE_TOOL=true
# LLM_MAX_TOKENS=280
# LLM_REASONING_EFFORT=none
